# Copy to .env and fill every blank secret before starting the bridge.
# .env is ignored by git. For Docker secrets, use the _FILE variants below and
# point them at files under /run/secrets.

# bridge (default) or capture. Capture is unsafe outside a trusted LAN/VPN.
MODE=bridge

# Bind address inside the container. Keep this at 0.0.0.0 in Docker.
LISTEN_HOST=0.0.0.0
LISTEN_PORT=6789

# iOS NZBClient connects to the bridge with these credentials, not to SABnzbd.
NZBGET_USERNAME=bridgeuser
NZBGET_PASSWORD=
# NZBGET_PASSWORD_FILE=/run/secrets/nzbget_password

# SABnzbd backend. Use the full API key, not the NZB key.
SABNZBD_URL=http://sabnzbd:8080
SABNZBD_API_KEY=
# SABNZBD_API_KEY_FILE=/run/secrets/sab_api_key

DATA_DIR=/data
ADVERTISED_NZBGET_VERSION=21.1

# Base64 + JSON overhead means a 32 MiB body carries about 23.95 MiB decoded.
# Use at least 34603008 to allow the full 24 MiB decoded NZB ceiling.
REQUEST_MAX_BYTES=33554432
NZB_MAX_DECODED_BYTES=25165824

HTTP_CONNECT_TIMEOUT=5
HTTP_READ_TIMEOUT=30
HTTP_WRITE_TIMEOUT=30
HTTP_POOL_TIMEOUT=5

LOG_LEVEL=INFO
LOG_FORMAT=json
TLS_VERIFY=true

# Only for isolated development. Requires an explicit true.
ALLOW_INSECURE_NO_AUTH=false
READYZ_CHECK_SAB=true
READYZ_TIMEOUT_SECONDS=2

# Host publishing. NZBClient uses port 6790 by default so it does not collide
# with a real NZBGet on 6789. Restrict BRIDGE_BIND_IP to a LAN/VPN address or
# 127.0.0.1 behind a TLS reverse proxy.
BRIDGE_BIND_IP=0.0.0.0
BRIDGE_PORT=6790

# Capture mode only. CAPTURE_NZBGET_URL is the existing NZBGet origin and may
# include a reverse-proxy subpath. Leave the SAB key blank in capture mode.
CAPTURE_NZBGET_URL=
CAPTURE_NZBGET_USERNAME=
CAPTURE_NZBGET_PASSWORD=
# CAPTURE_NZBGET_PASSWORD_FILE=/run/secrets/capture_nzbget_password
CAPTURE_XMLRPC=false

CAPTURE_DIR=/captures
CAPTURE_MAX_RECORDS=500
CAPTURE_MAX_TOTAL_BYTES=10485760
CAPTURE_MAX_RECORD_BYTES=65536
CAPTURE_INSPECT_MAX_BYTES=1048576
CAPTURE_MAX_RESPONSE_BYTES=67108864
# 0 disables retention deletion. A non-zero value must be at least 1 day.
CAPTURE_RETENTION_DAYS=0

# Set these to `id -u` and `id -g` when using docker-compose.capture.yml so the
# container can write shape-only fixtures into tests/fixtures/captured.
CAPTURE_UID=10001
CAPTURE_GID=10001
